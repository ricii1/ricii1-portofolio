# Turso (production). Leave both unset locally to fall back to a local sqlite file (file:local.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Generate with: npx tsx scripts/hash-password.ts <password>
ADMIN_PASSWORD_HASH=

# Random 32+ byte hex string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
